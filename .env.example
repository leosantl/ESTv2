# ════════════════════════════════════════════════════════════
# StandControl — Variáveis de Ambiente
# Copie para .env e preencha com seus valores
# ════════════════════════════════════════════════════════════

# Supabase — obtenha em: Settings > API no painel do projeto
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Apenas para gerar tipos (npm run db:types)
SUPABASE_PROJECT_ID=seu_project_id

# ────────────────────────────────────────────────────────────
# Asaas (pagamentos) — configurar nas Edge Functions via:
# supabase secrets set ASAAS_API_KEY=... ASAAS_ENV=sandbox
# ────────────────────────────────────────────────────────────
# ASAAS_API_KEY=          # chave da API Asaas (não expor no frontend)
# ASAAS_ENV=sandbox       # "sandbox" ou "production"
# ASAAS_WEBHOOK_TOKEN=    # token para validar webhooks recebidos
